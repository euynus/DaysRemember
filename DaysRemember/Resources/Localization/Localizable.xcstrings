    "这台设备缺少 %lld 个已同步到 iCloud 的日子。为防误删，删除暂未同步到其他设备。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld day synced to iCloud is missing on this device. To avoid deleting it by mistake, the deletion hasn’t been synced to your other devices."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld days synced to iCloud are missing on this device. To avoid deleting them by mistake, the deletions haven’t been synced to your other devices."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备缺少 %lld 个已同步到 iCloud 的日子。为防误删，删除暂未同步到其他设备。"
          }
        },
